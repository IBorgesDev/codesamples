{
	"name": "analytics",
	"servePort": 34875,
	"tree": {
		"$className": "DataModel",
		"ReplicatedStorage": {
			"$ignoreUnknownInstances": true,
			"Shared": {
				"$path": "src/shared"
			}
		},
		"ServerScriptService": {
			"$ignoreUnknownInstances": true,
			"Server": {
				"$path": "src/server"
			}
		},
		"ServerStorage": {
			"$ignoreUnknownInstances": true,
			"DevPackages": {
				"$path": "DevPackages"
			},
			"Tests": {
				"$path": "tests"
			},
			"Schema": {
				"$path": "schema"
			}
		}
	}
}
