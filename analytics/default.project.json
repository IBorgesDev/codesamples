{
	"name": "analytics",
	"servePort": 34875,
	"tree": {
		"$className": "DataModel",
		"ReplicatedStorage": {
			"$ignoreUnknownInstances": true,
			"Shared": {
				"$className": "Folder",
				"$ignoreUnknownInstances": false
			}
		},
		"ServerScriptService": {
			"$ignoreUnknownInstances": true,
			"Server": {
				"$path": "src/server"
			}
		},
		"ServerStorage": {
			"$ignoreUnknownInstances": true,
			"Schema": {
				"$path": "schema"
			}
		},
		"StarterPlayer": {
			"$ignoreUnknownInstances": true,
			"StarterPlayerScripts": {
				"$ignoreUnknownInstances": true,
				"Client": {
					"$className": "Folder",
					"$ignoreUnknownInstances": false
				}
			}
		}
	}
}
